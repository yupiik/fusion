<!-- OWASP Dependency-Check false positives, see https://dependency-check.github.io/DependencyCheck/general/suppression.html -->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.4.xsd"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.4.xsd
                                  https://dependency-check.github.io/DependencyCheck/dependency-suppression.1.4.xsd">
  <suppress>
    <notes><![CDATA[
    False positive: fusion-http-server-observability (Fusion health/metrics endpoints) is matched by name to
    obs-server (openSUSE Open Build Service server), CVE-2010-3782 does not apply to Fusion.
    ]]></notes>
    <packageUrl regex="true">^pkg:maven/io\.yupiik\.fusion/fusion-http-server-observability@.*$</packageUrl>
    <cpe>cpe:/a:obs-server:obs-server</cpe>
  </suppress>
</suppressions>
